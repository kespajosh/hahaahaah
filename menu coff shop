<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Arcadia Coffee Co.</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #F5EBDD;
    font-family: Georgia, serif;
    color: #3B1F0E;
}

.menu-section {
    padding: 45px 20px;
}

.menu-board {
    max-width: 950px;
    margin: auto;
    background: #F5EBDD;
    border: 5px solid #70452B;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(59,31,14,.15);
}

/* LOGO HEADER */

.menu-header {
    text-align: center;
    padding-bottom: 20px;
    margin-bottom: 30px;
    border-bottom: 2px solid #C58B55;
}

.menu-header img {
    width: 220px;
    height: 150px;
    object-fit: contain;
}

.menu-header h1 {
    font-size: 25px;
    letter-spacing: 5px;
    color: #3B1F0E;
}

.menu-header p {
    font-size: 11px;
    letter-spacing: 4px;
    margin-top: 10px;
    color: #70452B;
}

/* MENU GRID */

.menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
}

.menu-box {
    border: 1px solid #A8784E;
    padding: 15px;
    margin-bottom: 10px;
    background: #FBF7F0;
}

.menu-box h2 {
    background: #3B1F0E;
    color: #F5EBDD;
    text-align: center;
    padding: 12px;
    margin: -15px -15px 15px;
    font-size: 17px;
    letter-spacing: 2px;
}

/* CATEGORY PHOTOS */

.menu-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 3px;
    margin-bottom: 15px;
}

/* MENU ITEMS */

.menu-item {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px dotted #B99A7B;
    padding: 11px 0;
    font-size: 14px;
}

.menu-item span:last-child {
    color: #8B542D;
    font-weight: bold;
    white-space: nowrap;
}

/* FOOTER */

.menu-footer {
    text-align: center;
    border-top: 2px solid #C58B55;
    margin-top: 25px;
    padding-top: 20px;
    color: #70452B;
    letter-spacing: 2px;
    line-height: 2;
}

@media(max-width: 650px) {
    .menu-grid {
        grid-template-columns: 1fr;
    }

    .menu-board {
        padding: 18px;
    }
}
</style>
</head>

<body>

<section class="menu-section">

