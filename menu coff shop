        </div>

        <!-- ICED BLENDED -->

        <div class="menu-box">

            <h2>ICED BLENDED DRINKS</h2>

            <img class="menu-image"
            src="https://www.cfw.co.uk/site/SCA/cfw-product-images/Monin%20Coffee%20Frappe%20Mix%201.36kg_main-3.jpg"
